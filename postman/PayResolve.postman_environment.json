      "value": "your_sandbox_client_secret",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "api_base_url",
      "value": "http://localhost:8080",
      "type": "default",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}
