{
  "info": {
    "_postman_id": "payresolve-collection-v1",
    "name": "PayResolve AI Sandbox & API",
    "description": "API collection for PayPal Sandbox payments, webhooks, and PayResolve exception management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "PayPal Sandbox",
      "item": [
        {
          "name": "Get Access Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Accept-Language", "value": "en_US" }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{paypal_client_id}}", "type": "string" },
                { "key": "password", "value": "{{paypal_client_secret}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{paypal_base_url}}/v1/oauth2/token",
              "host": ["{{paypal_base_url}}"],
              "path": ["v1", "oauth2", "token"]
            }
          }
        }
      ]
    },
    {
      "name": "PayResolve API",
      "item": [
        {
          "name": "List Cases",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{api_base_url}}/api/cases",
              "host": ["{{api_base_url}}"],
              "path": ["api", "cases"]
            }
          }
        },
        {
          "name": "PayPal Webhook Ingest",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"WH-SAMPLE-EVENT-001\",\n  \"event_type\": \"PAYMENT.CAPTURE.COMPLETED\",\n  \"resource_type\": \"capture\",\n  \"resource\": {}\n}"
            },
            "url": {
              "raw": "{{api_base_url}}/api/webhooks/paypal",
              "host": ["{{api_base_url}}"],
              "path": ["api", "webhooks", "paypal"]
            }
          }
        }
      ]
    }
  ]
}
