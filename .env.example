# ==============================================================================
# PayResolve AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in real values.
# IMPORTANT: Do not use quotes around values (e.g. write KEY=value, NOT KEY="value").
# NEVER commit the .env file to version control.
# ==============================================================================

# --- Server & Networking ---
# Application server port
SERVER_PORT=8080

# Public URL used for PayPal approval redirects & webhook registration (ngrok, tunnel, or Render URL)
APP_PUBLIC_URL=http://localhost:8080

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Demo mode: enables synthetic fault-injection switches and scenario sandbox
DEMO_MODE=true

# Operator web session expiration duration
SESSION_TIMEOUT=30m

# --- Database (Supabase PostgreSQL via Session Pooler) ---
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> JDBC / Session Pooler
# Format: jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase database user. Format: postgres.[PROJECT_REF]
DB_USER=postgres.PROJECT_REF

# Supabase database password set during project creation
DB_PASSWORD=your_supabase_db_password

# --- Supabase Project & API Configuration ---
# Supabase project URL (format: https://[PROJECT_REF].supabase.co)
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Supabase anonymous public API key
SUPABASE_ANON_KEY=your_supabase_anon_key

# --- PayPal Sandbox ---
# PayPal Sandbox API base URL
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal Developer Dashboard -> Apps & Credentials -> Sandbox REST App Client ID
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# PayPal Developer Dashboard -> Apps & Credentials -> Sandbox REST App Secret
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# PayPal Developer Dashboard -> Webhooks -> Sandbox Webhook ID for signature verification
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id

# --- AI Investigator (Google Gemini via Spring AI) ---
# Active AI provider (gemini)
AI_PROVIDER=gemini

# Google AI Studio API Key (free tier: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key

# Model identifier (e.g. gemini-2.0-flash or gemini-1.5-flash)
AI_MODEL=gemini-2.0-flash

# --- Application Authentication & Roles ---
# Operator role credentials (can investigate and approve actions)
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=your_operator_password

# Viewer role credentials (read-only demo access for hackathon judges)
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=your_viewer_password

# --- AG Studio Analytics License (Optional / Free Trial) ---
# AG Studio free trial or enterprise license key (uncomment and set if using commercial license)
# Never commit real license keys to git repository.
VITE_AG_LICENSE=your_ag_studio_license_key

