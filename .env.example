# ==========================================
# PayResolve AI — Environment Configuration
# ==========================================
# Copy this file to .env and fill in real sandbox credentials.
# NEVER commit real credentials to git.

# PayPal Sandbox Configuration
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here

# PostgreSQL Database
DATABASE_URL=jdbc:postgresql://localhost:5432/payresolve
DB_USER=postgres
DB_PASSWORD=postgres

# AI Configuration (Spring AI)
AI_PROVIDER=openai
AI_API_KEY=your_llm_api_key_here
AI_MODEL=gpt-4o-mini

# Authentication & Demo Roles
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=operator_demo_password
VIEWER_PASSWORD=viewer_demo_password

# Public URL (for webhooks & approval redirects, e.g., ngrok or Render URL)
APP_PUBLIC_URL=http://localhost:8080
